# Test runner image for the local Hermes fork.
#
# The production Dockerfile intentionally tracks the runtime image, currently
# on Python 3.13.  CI tests run on Python 3.11, so keep a separate test image
# that mirrors the CI Python version while still carrying Node/npm for the web
# and TUI workspaces.
FROM ghcr.io/astral-sh/uv:0.11.6-python3.11-trixie

ARG HERMES_DOCKER_INSTALL_NODE_DEPS=0

ENV PYTHONUNBUFFERED=1
ENV npm_config_install_links=false
ENV HERMES_TEST_VENV=/opt/hermes-test-venv
ENV PATH="/opt/hermes-test-venv/bin:${PATH}"

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      build-essential \
      curl \
      docker-cli \
      ffmpeg \
      gcc \
      git \
      libffi-dev \
      nodejs \
      npm \
      openssh-client \
      procps \
      python3 \
      python3-dev \
      ripgrep \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Copy the full checkout before installing Node dependencies.  Upstream now uses
# a single root package-lock.json for npm workspaces, so per-workspace lockfiles
# such as web/package-lock.json and ui-tui/package-lock.json may not exist.
# The repository's .dockerignore keeps host venvs/node_modules/runtime state out
# of this layer.
COPY . .

# .git is intentionally excluded from the Docker build context to keep the test
# image small, but update-path tests expect PROJECT_ROOT to be a git checkout.
# A lightweight repository is sufficient because tests mock remote operations.
RUN git init -q . && \
    git config user.email "test@example.invalid" && \
    git config user.name "Hermes Test"

# Python test runs do not require Node dependencies, and installing the full npm
# workspace can make ordinary pytest verification depend on flaky registry
# downloads.  Set HERMES_DOCKER_INSTALL_NODE_DEPS=1 for containerized asset
# builds that need node_modules.  --ignore-scripts avoids heavyweight browser
# downloads from optional browser packages during test-image construction.
RUN if [ "$HERMES_DOCKER_INSTALL_NODE_DEPS" = "1" ]; then \
      npm config set fetch-retries 5 && \
      npm config set fetch-retry-mintimeout 20000 && \
      npm config set fetch-retry-maxtimeout 120000 && \
      npm config set fetch-timeout 600000 && \
      npm install --prefer-offline --no-audit --ignore-scripts && \
      npm cache clean --force; \
    else \
      echo "Skipping npm workspace install for Python test image"; \
    fi

RUN uv venv "$HERMES_TEST_VENV" --python 3.11 && \
    uv pip install --python "$HERMES_TEST_VENV/bin/python" --no-cache-dir -e ".[all,dev]" && \
    uv pip install --python "$HERMES_TEST_VENV/bin/python" --no-cache-dir build "pytest-split>=0.9,<1"

CMD ["scripts/run_tests.sh"]
