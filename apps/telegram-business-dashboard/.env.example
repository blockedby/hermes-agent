# Server-only. Never expose this with NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=

# Comma-separated numeric Telegram user IDs allowed to open the dashboard.
TELEGRAM_ADMIN_USER_IDS=

# Public browser-safe metadata.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
NEXT_PUBLIC_TELEGRAM_WEBAPP_URL=http://localhost:3000
# Copy the deployed public URL to Hermes gateway config/env as
# telegram.business_dashboard_webapp_url or TELEGRAM_BUSINESS_DASHBOARD_WEBAPP_URL.

# Vercel BFF -> Hermes VPS API. Server-only. Never expose with NEXT_PUBLIC_.
HERMES_DASHBOARD_API_BASE_URL=
HERMES_DASHBOARD_API_TOKEN=
